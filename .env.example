NODE_ENV=development
# 3010 avoids clashing with Next.js projects that conventionally use 3000
PORT=3010
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=change-me-min-16-chars-secret
LOG_LEVEL=debug
RABBITMQ_URL=amqp://admin:admin@localhost:5672
REDIS_URL=redis://localhost:6379
# File storage
STORAGE_DRIVER=local # or s3
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
# Required when STORAGE_DRIVER=s3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: MinIO/LocalStack compatible endpoint
S3_ENDPOINT=
# Multi-tenancy
# App base host used by the tenant router. Subdomains are resolved as
# {subdomain}.APP_BASE_HOST. Defaults to "localhost" in development.
APP_BASE_HOST=localhost
